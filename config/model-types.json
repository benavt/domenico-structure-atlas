      "key": "afcluster",
      "name": "AF-Cluster",
      "enabled": true,
      "priority": 1,
      "match": {
        "fields": [
          "model",
          "source_path"
        ],
        "contains_any": [
          "__afcluster__"
        ],
        "contains_all": [],
        "contains_none": [],
        "regex_any": [],
        "case_insensitive": false
      },
      "assign": {
        "model_type": "AF-Cluster",
        "model_version": null
      },
      "color": "#4477AA"
    },
